    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.0",
    "slugify": "^1.6.6",
    "stripe": "^17.5.0",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.4.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
